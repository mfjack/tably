# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# no Supabase (Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL pública do app (usada nos links de confirmação de email e de senha).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCTION_URL=https://seu-dominio.vercel.app

# Chave secreta do Supabase (Project Settings → API Keys → Secret keys).
# Só no servidor: usada pelo webhook do Asaas para registrar pagamentos.
SUPABASE_SECRET_KEY=sb_secret_...

# Cobrança automática pelo Asaas. Sem essas variáveis, a assinatura continua
# com o Pix manual. Use a URL de sandbox para testar e a de produção depois.
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
