# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# no Supabase (Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL pública do app (usada nos links de confirmação de email e de senha).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCTION_URL=https://seu-dominio.vercel.app

# Segredo para assinar a sessão dos operadores (mínimo 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OPERATOR_SESSION_SECRET=
